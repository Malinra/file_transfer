# ==========================================
# File Transfer 环境变量配置示例
# ==========================================

# 监听 IP 地址 (0.0.0.0 允许局域网/公网访问, 127.0.0.1 仅本机)
HOST=0.0.0.0

# 监听端口
PORT=18000

# 用户账号与授权目录配置文件路径 (默认当前目录下 users.json)
USERS_FILE=./users.json

# 会话有效时间（秒），默认 43200 秒（12 小时）
SESSION_TTL=43200
